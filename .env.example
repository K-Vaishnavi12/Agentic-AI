# Ollama (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Use phi3 or tinyllama if you have <5GB free RAM; mistral needs ~4.5GB
OLLAMA_MODEL=phi3

# ChromaDB persistence
CHROMA_PERSIST_DIR=./data/chroma

# Data paths (offline sources)
DATA_DIR=./data
STOCK_DATA_PATH=./data/stock
LEGAL_DATA_PATH=./data/legal
STARTUP_DATA_PATH=./data/startup

# RBAC (optional: strict mode)
STRICT_RBAC=true

# ── ML configuration ──────────────────────────────────────────────
# Where trained model artifacts live (forecasting, anomaly, NLP)
MODELS_DIR=./models
# Where evaluation reports & plots are written
REPORTS_DIR=./reports
# Where raw/processed ML datasets live
ML_DATA_DIR=./data/ml
# Reproducibility
ML_SEED=42
# How many days the LSTM looks back when forecasting
ML_LOOKBACK=60
# Forecast horizon (days)
ML_HORIZON=5
# Transformer model name for sentiment/legal fine-tune
ML_TRANSFORMER_BASE=distilbert-base-uncased
# Set to 1 to skip transformer fine-tune (CPU-friendly fallback to TF-IDF)
ML_SKIP_TRANSFORMER=0
